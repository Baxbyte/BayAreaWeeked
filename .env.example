# Public URL of the site (custom domain strongly recommended for SEO)
SITE_URL=https://baxbyte.github.io/BayAreaWeeked
SITE_NAME=Bay Area Weekend
# Where signup / sponsor forms POST JSON (Formspree, Buttondown, Google Apps Script, your API…)
PUBLIC_SIGNUP_ENDPOINT=
PUBLIC_SPONSOR_ENDPOINT=
PUBLIC_CONTACT_EMAIL=
# Search engine verification + instant indexing
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
# Optional event sources
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Optional geocoding of venues via OpenStreetMap (1 req/sec, cached in data/geocache.json)
GEOCODE=1
GEOCODE_MAX=150
