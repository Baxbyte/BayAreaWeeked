---
// Real Bay Area map. Renders an accurate SVG of the actual county shorelines instantly (and for no-JS / crawlers),
// then upgrades to a live, zoomable street map (Leaflet) with clickable regions and cities.
import { link } from '../lib/site.mjs';
import { SITE } from '../lib/site.mjs';
import { REGIONS, CITIES, COUNTS } from '../lib/data.mjs';
import boundaries from '../data/boundaries.json';

const VIEW = { w: -123.08, e: -121.55, n: 38.62, s: 36.98 };
const K = Math.cos((37.8 * Math.PI) / 180);
const S = 560;
const P = (x, y) => [((x - VIEW.w) * K * S).toFixed(1), ((VIEW.n - y) * S).toFixed(1)];
const width = ((VIEW.e - VIEW.w) * K * S).toFixed(0);
const height = ((VIEW.n - VIEW.s) * S).toFixed(0);
const toPath = (g) => g.coordinates.map((poly) => poly.map((r) => `M${r.map(([x, y]) => P(x, y).join(',')).join('L')}Z`).join('')).join('');
const fills = { 'san-francisco': '#ffd2c2', 'east-bay': '#ffe7a3', peninsula: '#c4efe6', 'south-bay': '#cfe0ff', 'north-bay': '#e6dbff' };
const labelAt = { 'north-bay': [-122.62, 38.3], 'san-francisco': [-122.44, 37.765], peninsula: [-122.33, 37.39], 'south-bay': [-121.87, 37.25], 'east-bay': [-122.02, 37.8] };
const cityDots = ['oakland', 'berkeley', 'san-jose', 'palo-alto', 'san-mateo', 'walnut-creek', 'fremont', 'san-rafael', 'napa', 'santa-rosa', 'half-moon-bay', 'mountain-view', 'sausalito', 'livermore', 'petaluma', 'redwood-city']
  .map((s) => CITIES.find((c) => c.slug === s)).filter(Boolean);
const mapData = {
  regions: REGIONS.map((r) => ({ slug: r.slug, name: r.name, emoji: r.emoji, count: COUNTS.region[r.slug] || 0, href: link(`/region/${r.slug}/`), label: labelAt[r.slug], fill: fills[r.slug] })),
  cities: cityDots.map((c) => ({ name: c.name, lat: c.lat, lng: c.lng, href: link(`/city/${c.slug}/`), count: COUNTS.city[c.slug] || 0 })),
  tiles: SITE.tiles, attr: SITE.tilesAttribution,
};
---
<div class="realmap" data-realmap={JSON.stringify(mapData)}>
  <svg class="baymap" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="bm-t" preserveAspectRatio="xMidYMid slice">
    <title id="bm-t">Map of the San Francisco Bay Area regions — choose one to see events</title>
    {REGIONS.map((r) => (
      <a href={link(`/region/${r.slug}/`)} aria-label={`${r.name}: ${COUNTS.region[r.slug] || 0} things to do`}>
        {boundaries.regions.features.filter((f) => f.properties.region === r.slug).map((f) => <path class="region" d={toPath(f.geometry)} style={`fill:${fills[r.slug]}`} />)}
      </a>
    ))}
    {cityDots.map((c) => { const [x, y] = P(c.lng, c.lat); return <a href={link(`/city/${c.slug}/`)}><circle class="dot" cx={x} cy={y} r="4" /><text class="city-label" x={+x + 6} y={+y + 3}>{c.name}</text></a>; })}
    {REGIONS.map((r) => { const [x, y] = P(...labelAt[r.slug]); return <g><text class="label" x={x} y={y} text-anchor="middle">{r.name}</text><text class="count" x={x} y={+y + 15} text-anchor="middle">{COUNTS.region[r.slug] || 0} things to do</text></g>; })}
  </svg>
  <div class="realmap-live" aria-hidden="true"></div>
  <div class="realmap-hint">🖱️ Drag, zoom &amp; tap a region</div>
</div>
<script>
  import { initRegionMap } from '../scripts/regionmap.js';
  initRegionMap();
</script>
