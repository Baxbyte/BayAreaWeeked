---
// Visible FAQ + FAQPage structured data (great for answer engines and "People also ask").
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
const ld = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
{items.length > 0 && (
  <section class="section faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{title}</h2>
    {items.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </section>
)}
