---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE, link, absolute } from '../lib/site.mjs';
import { REGIONS, CITIES, NEIGHBORHOODS, VIBES, CATEGORIES, COUNTS, UPDATED } from '../lib/data.mjs';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  jsonld?: object[];
  noindex?: boolean;
  nav?: string;
  ogType?: string;
  fullWidth?: boolean;
}
const { title, description, path, image, jsonld = [], noindex = false, nav = '', ogType = 'website', fullWidth = false } = Astro.props;
const canonical = absolute(path);
const ogImage = image || absolute('/og-default.png');
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const topCities = CITIES.filter((c) => c.slug !== 'san-francisco' && (COUNTS.city[c.slug] || 0) > 0).sort((a, b) => (COUNTS.city[b.slug] || 0) - (COUNTS.city[a.slug] || 0)).slice(0, 12);
const sfHoods = NEIGHBORHOODS.filter((n) => n.city === 'san-francisco' && (COUNTS.hood[n.slug] || 0) > 0).slice(0, 14);
const navItems = [
  ['weekend', '/this-weekend/', 'This Weekend'],
  ['explore', '/explore/', 'Map & Search'],
  ['directory', '/directory/', 'Neighborhoods'],
  ['next-week', '/next-week/', 'Next Week'],
  ['deals', '/deals/', 'Deals'],
];
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: absolute('/'),
  logo: absolute('/favicon.svg'),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#fbf7f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1222" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="San Francisco Bay Area" />
    <meta property="article:modified_time" content={UPDATED.toISOString()} />
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
    {SITE.bingVerification && <meta name="msvalidate.01" content={SITE.bingVerification} />}
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <link rel="manifest" href={link('/manifest.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — new events`} href={link('/rss.xml')} />
    <link rel="alternate" type="application/feed+json" title={`${SITE.name} JSON feed`} href={link('/feed.json')} />
    <link rel="sitemap" type="application/xml" href={link('/sitemap.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
    {SITE.analyticsScript && <script defer src={SITE.analyticsScript}></script>}
    <slot name="head" />
  </head>
  <body data-base={link('/')}>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={link('/')} aria-label={`${SITE.name} home`}><Logo /> <span>{SITE.name}</span></a>
        <nav class="nav" aria-label="Main">
          {navItems.map(([k, href, label]) => <a href={link(href)} aria-current={nav === k ? 'page' : undefined}>{label}</a>)}
        </nav>
        <form class="header-search" action={link('/explore/')} method="get" role="search">
          <label class="sr-only" for="hq">Search events</label>
          <input id="hq" name="q" type="search" placeholder="Try “free kids stuff in Oakland”" autocomplete="off" />
        </form>
        <div class="header-actions">
          <a class="icon-btn" href={link('/plan/')} aria-label="My weekend plan" title="My weekend plan">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.4 5 7 5c2 0 3.5 1.1 5 3 1.5-1.9 3-3 5-3 3.6 0 5.8 3.6 4.5 6.8C19.5 16.4 12 21 12 21z"/></svg>
            <span class="badge" data-saved-count></span>
          </a>
          <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" data-menu-btn>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <nav class="mobile-nav" data-mobile-nav aria-label="Mobile">
        <form action={link('/explore/')} method="get" role="search"><input class="input" style="width:100%" name="q" type="search" placeholder="Search events, places, vibes…" /></form>
        {navItems.map(([, href, label]) => <a href={link(href)}>{label}</a>)}
        <a href={link('/plan/')}>❤️ My Plan</a>
        <a href={link('/subscribe/')}>✉️ Get the daily email</a>
        <a href={link('/advertise/')}>📣 Advertise / Sponsor</a>
      </nav>
    </header>

    <main id="main" class={fullWidth ? '' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="logo" href={link('/')}><Logo /> <span>{SITE.name}</span></a>
            <p class="muted" style="margin-top:12px">{SITE.tagline}</p>
            <p class="updated">Updated {UPDATED.toLocaleDateString('en-US', { timeZone: 'America/Los_Angeles', weekday: 'short', month: 'short', day: 'numeric' })}</p>
          </div>
          <div>
            <h4>When</h4>
            <ul>
              <li><a href={link('/today/')}>Today</a></li>
              <li><a href={link('/tonight/')}>Tonight</a></li>
              <li><a href={link('/this-weekend/')}>This weekend</a></li>
              <li><a href={link('/next-week/')}>Next week</a></li>
              <li><a href={link('/next-weekend/')}>Next weekend</a></li>
              <li><a href={link('/plan/')}>My plan</a></li>
            </ul>
          </div>
          <div>
            <h4>Regions</h4>
            <ul>{REGIONS.map((r) => <li><a href={link(`/region/${r.slug}/`)}>{r.name}</a></li>)}</ul>
          </div>
          <div>
            <h4>Cities</h4>
            <ul>{topCities.map((c) => <li><a href={link(`/city/${c.slug}/`)}>{c.name}</a></li>)}</ul>
          </div>
          <div>
            <h4>SF neighborhoods</h4>
            <ul>{sfHoods.map((n) => <li><a href={link(`/city/san-francisco/${n.slug}/`)}>{n.name}</a></li>)}</ul>
          </div>
          <div>
            <h4>Vibes</h4>
            <ul>{VIBES.map((v) => <li><a href={link(`/${v.slug}/`)}>{v.emoji} {v.name}</a></li>)}</ul>
          </div>
          <div>
            <h4>Genres</h4>
            <ul>{CATEGORIES.slice(0, 12).map((c) => <li><a href={link(`/category/${c.slug}/`)}>{c.name}</a></li>)}</ul>
          </div>
          <div>
            <h4>More</h4>
            <ul>
              <li><a href={link('/deals/')}>Ticket deals</a></li>
              <li><a href={link('/advertise/')}>Advertise &amp; bid for top spots</a></li>
              <li><a href={link('/subscribe/')}>Daily email (early access)</a></li>
              <li><a href={link('/directory/')}>Full directory</a></li>
              <li><a href={link('/faq/')}>FAQ</a></li>
              <li><a href={link('/about/')}>About &amp; sources</a></li>
              <li><a href={link('/photo-credits/')}>Photo credits</a></li>
              <li><a href={link('/rss.xml')}>RSS feed</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} {SITE.name}. Listings are compiled from public sources — always confirm details with the organizer.</span>
          <span><a href={link('/about/')}>About</a> · <a href={link('/advertise/')}>Advertise</a> · <a href={link('/sitemap.xml')}>Sitemap</a></span>
        </div>
      </div>
    </footer>
    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      import { initSaves } from '../scripts/saves.js';
      initSaves();
      const btn = document.querySelector('[data-menu-btn]');
      const nav = document.querySelector('[data-mobile-nav]');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
